# ============================================================================
# AutoTrader Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Choose ONE provider: Anthropic (recommended) or OpenAI

# Anthropic (Claude) - Recommended for trading decisions
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# OpenAI (GPT) - Alternative provider
# OPENAI_API_KEY=sk-your-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------------------------
# MetaTrader 5 Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# HTTP API endpoint for MT5 MCP server
MT5_BASE_URL=http://localhost:8001/api/v1

# Request timeout in seconds
MT5_TIMEOUT=30

# ----------------------------------------------------------------------------
# Trading Pairs Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of symbols to trade
SYMBOLS=EURUSD,GBPUSD

# Comma-separated list of timeframes to analyze
# Supported: 15m, 1h, 4h, 1w
TIMEFRAMES=15m,1h,4h,1w

# ----------------------------------------------------------------------------
# Risk Management Configuration (CRITICAL)
# ----------------------------------------------------------------------------
# Maximum risk per trade as percentage of account balance
# Recommended: 0.5-1.0% for conservative, 1.0-2.0% for moderate
MAX_RISK_PER_TRADE_PCT=1.0

# Default risk/reward ratio for take profit calculation
DEFAULT_RISK_REWARD_RATIO=2.0

# Minimum confidence score to execute trade (0.0-1.0)
# Higher = more selective, Lower = more trades
CONFIDENCE_THRESHOLD=0.75

# Minimum phase 1 score (higher timeframe bias)
PHASE1_FLOOR=0.50

# Minimum phase 2 score (entry quality)
PHASE2_FLOOR=0.50

# Minimum risk/reward ratio to execute
MIN_RR_RATIO=1.5

# Maximum daily loss as percentage of account balance
MAX_DAILY_LOSS_PCT=3.0

# Maximum number of trades per day
MAX_TRADES_PER_DAY=5

# ----------------------------------------------------------------------------
# News Filter Configuration
# ----------------------------------------------------------------------------
# Minutes to look ahead for high-impact news
NEWS_LOOKBACK_MINUTES=60

# Currencies to monitor for news (comma-separated)
HIGH_IMPACT_CURRENCIES=USD,EUR,GBP

# ----------------------------------------------------------------------------
# Scheduler Configuration
# ----------------------------------------------------------------------------
# Analysis interval in seconds (900 = 15 minutes)
DEFAULT_ANALYSIS_INTERVAL=900

# Market hours (24-hour format)
MARKET_OPEN_HOUR=0
MARKET_CLOSE_HOUR=22

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=true

# Log file path
LOG_FILE_PATH=./logs/trader_ai.log

# ----------------------------------------------------------------------------
# Trading Mode Configuration (IMPORTANT)
# ----------------------------------------------------------------------------
# Paper trading mode (ALWAYS START WITH TRUE)
# true = Simulate trades without real execution
# false = Execute real trades (USE WITH CAUTION)
PAPER_TRADING_MODE=true

# Human-in-the-loop mode (future feature)
HUMAN_IN_THE_LOOP=false

# ============================================================================
# SAFETY CHECKLIST BEFORE GOING LIVE
# ============================================================================
# [ ] Tested in paper mode for at least 1 week
# [ ] Reviewed all paper trade decisions
# [ ] Verified risk management calculations
# [ ] Set MAX_RISK_PER_TRADE_PCT to 0.5% or lower initially
# [ ] Set MAX_TRADES_PER_DAY to 2-3 initially
# [ ] Confirmed MT5 connection is stable
# [ ] Verified API keys are valid
# [ ] Reviewed and understood all configuration options
# [ ] Have monitoring system in place
# [ ] Ready to watch first few live trades closely
# ============================================================================
